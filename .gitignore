# Agent profile cache (generated at runtime, never commit)
.github/agents/.cache/

# Imprint — personal instance files must never be committed (private context)
# The schema (.schema.json) and example (.example.json) files are tracked — only instances are excluded
Imprint.json
**/Imprint.json

# Bridge files generated by Sync-SharedConsciousness.ps1 — these are personal and machine-specific
# (copilot-instructions.md, CLAUDE.md, .cursorrules, GEMINI.md, AGENTS.md etc. at user-level paths)
# Repo-level bridge files are excluded here; user-level files live outside the repo entirely
CLAUDE.md
GEMINI.md
AGENTS.md

# Ignore externally installed or test agent files — only track agents maintained by this repo
# (agents installed via vscode-copilot-sync, install.ps1, or manual testing are not committed)
.github/agents/*.agent.md
!.github/agents/NeuroGraft.agent.md
!.github/agents/Fetch.agent.md

# vscode-copilot-sync generated files — external subscriptions, NOT Symdicate content
.github/.copilot-subscriptions.json
.github/instructions/
.github/skills/

# Gemini projection target — generated by project.ps1 / project.sh
.agents/

# VS Code local settings — ignore the folder, allow shared config files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini

# Node (npx/npm tooling used for markdownlint etc.)
node_modules/
npm-debug.log*
*.log

# Release build output (generated by release workflow; ignored locally)
dist/

# PowerShell transcripts (generated when debugging installers)
Transcript*
*.pslog

# Temp / scratch files
*.tmp
*.bak
*.swp
